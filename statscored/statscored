#!/usr/bin/lua

table.unpack = table.unpack or unpack
local posix = require("posix")
local present = require("present")

local STATSCORE_PATH = "/dev/shm/statscore.lua"

local TICK_PERIOD = 4
local CPU_LOAD_PERIOD_TICKS = 1
local MEM_PERIOD_TICKS = 1
local ROOTFS_PERIOD_TICKS = 64
local TEMPS_PERIOD_TICKS = 8
local BATS_PERIOD_TICKS = 16
local NETFACES_PERIOD_TICKS = 2

---------------------
--- serialization ---
---------------------

---@param n number|boolean
local function serialize_number_or_boolean(n)
	return n ~= n and "(0/0)" or -math.huge >= n and "(1/0)" or n >= math.huge and "(-1/0)" or tostring(n)
end

---@param s string
local function serialize_string(s)
	return string.format("%q", s)
end

---@param obj any
---@return string
local function serialize(obj)
	local t = type(obj)

	if t == "number" or t == "boolean" then
		return serialize_number_or_boolean(obj)
	elseif t == "string" then
		return serialize_string(obj)
	elseif t == "table" then
		local pairs_slzd = {}
		for k, v in pairs(obj) do
			local kt = type(k)

			---@type string?
			local k_slzd = nil
			if kt == "string" and k:match("^[%w_][%w_%d]*$") then
				k_slzd = k
			else
				if kt == "number" or kt == "boolean" then
					k_slzd = serialize_number_or_boolean(k)
				elseif kt == "string" then
					k_slzd = serialize_string(k)
				end
				k_slzd = k_slzd and "[" .. k_slzd .. "]"
			end

			pairs_slzd[#pairs_slzd + 1] = k_slzd and (k_slzd .. " = " .. serialize(v))
				or "--[[inaccessible " .. kt .. " key]]"
		end
		return "{ " .. table.concat(pairs_slzd, ", ") .. " }"
	elseif t == "function" then
		return "function(...) end"
	elseif t == "nil" then
		return "nil"
	else
		return "nil --[[unserializable " .. t .. "]]"
	end
end

------------
--- main ---
------------

---@type {fn: function, period: integer}[]
local score_sources = {
	{ fn = present.cpu, period = CPU_LOAD_PERIOD_TICKS },
	{ fn = present.mem, period = MEM_PERIOD_TICKS },
	{ fn = present.rootfs, period = ROOTFS_PERIOD_TICKS },
	{ fn = present.bats, period = BATS_PERIOD_TICKS },
	{ fn = present.temps, period = TEMPS_PERIOD_TICKS },
	{ fn = present.netfaces, period = NETFACES_PERIOD_TICKS },
}

local tick = 0
while true do
	for _, score_source in ipairs(score_sources) do
		if tick % score_source.period == 0 then
			score_source.fn()
		end
	end

	local f = io.open(STATSCORE_PATH, "w")
	if f then
		f:write("return " .. serialize(present.ation))
		f:close()
	end

	posix.sleep(TICK_PERIOD)
	tick = tick + 1
end
