#!/usr/bin/lua

local unistd = require("posix.unistd")

--- @param f file*
--- @return string
local function reread(f)
	f:seek("set")
	return f:read("*a")
end

--- @alias SiPrefix ""|"k"|"M"|"G"|"T"

--- @param size number
--- @param prefix SiPrefix?
--- @return { [1]: number, [2]: string }
local function readable_si_size(size, prefix)
	local PREFIXES = { "", "k", "M", "G", "T" }

	local prefix_i = 1
	for i, p in ipairs(PREFIXES) do
		if p == prefix then
			prefix_i = i
			break
		end
	end

	while size > 1024 do
		size = size / 1024
		prefix_i = prefix_i + 1
	end

	return { size, PREFIXES[math.min(prefix_i, #PREFIXES)] }
end

------------------
--- collection ---
------------------

--- one-time ---

--- @return integer?
local function collect_cpu_core_count()
	local cpuinfo = io.open("/proc/cpuinfo", "r")
	if not cpuinfo then
		return
	end

	local count = 0
	for _ in cpuinfo:read("*a"):gmatch("processor%s+:%s+(%d+)") do
		count = count + 1
	end
	return count
end
local cpu_core_count = collect_cpu_core_count()

--- repeating ---

local loadavg = io.open("/proc/loadavg", "r")
--- @return number?
local function collect_cpu_load_percent()
	if not loadavg then
		return
	end

	loadavg:seek("set")
	local loadavg_str = loadavg:read("*a")

	local load = tonumber(loadavg_str:match("[%d.]+"))
	local load_percent = load and tonumber(load) * 100 / cpu_core_count

	return load_percent
end

local meminfo = io.open("/proc/meminfo", "r")
--- @return { [1]: number, [2]: SiPrefix }?, { [1]: number, [2]: SiPrefix }?
local function collect_mem_swap()
	if not meminfo then
		return
	end

	meminfo:seek("set")
	local meminfo_str = meminfo:read("*a")

	local mem_total = tonumber(meminfo_str:match("MemTotal:%s+(%d+)"))
	local mem_free = tonumber(meminfo_str:match("MemAvailable:%s+(%d+)"))
	local swap_total = tonumber(meminfo_str:match("SwapTotal:%s+(%d+)"))
	local swap_free = tonumber(meminfo_str:match("SwapFree:%s+(%d+)"))

	local mem_used = mem_total and mem_free and mem_total - mem_free
	local swap_used = swap_total and swap_free and swap_total - swap_free

	return mem_used and readable_si_size(mem_used, "k"), swap_used and readable_si_size(swap_used, "k")
end

--- @return { [1]: number, [2]: SiPrefix }?
local function collect_rootfs()
	local stat = io.popen("stat -f / -c 'available blocks: %a\nblock size: %S'")
	if not stat then
		return
	end

	--- @type string
	local stat_str = stat:read("*a")

	local rootfs_free_blocks = tonumber(stat_str:match("available blocks:%s+(%d+)"))
	local rootfs_block_size = tonumber(stat_str:match("block size:%s+(%d+)"))

	local rootfs_free = rootfs_free_blocks and rootfs_block_size and rootfs_free_blocks * rootfs_block_size

	return rootfs_free and readable_si_size(rootfs_free)
end

