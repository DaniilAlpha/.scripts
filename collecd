#!/usr/bin/lua

local unistd = require("posix.unistd")
local lfs = require("lfs")
table.unpack = table.unpack or unpack

--- @alias SiPrefix ""|"k"|"M"|"G"|"T"

--- @param size number
--- @param prefix SiPrefix?
--- @return { [1]: number, [2]: string }
local function readable_si_size(size, prefix)
	local PREFIXES = { "", "k", "M", "G", "T" }

	local prefix_i = 1
	for i, p in ipairs(PREFIXES) do
		if p == prefix then
			prefix_i = i
			break
		end
	end

	while size > 1024 do
		size = size / 1024
		prefix_i = prefix_i + 1
	end

	return { size, PREFIXES[math.min(prefix_i, #PREFIXES)] }
end

------------------
--- collection ---
------------------

--- one-time ---

--- @return integer?
local function collect_cpu_core_count()
	local cpuinfo = io.open("/proc/cpuinfo", "r")
	if not cpuinfo then
		return
	end

	local count = 0
	for _ in cpuinfo:read("*a"):gmatch("processor%s+:%s+(%d+)") do
		count = count + 1
	end

	return count
end

--- repeating ---

--- @param core_count number?
--- @return number?
local function collect_cpu_load_percent(core_count)
	local loadavg_file = io.open("/proc/loadavg", "r")
	if not loadavg_file then
		return
	end

	core_count = core_count or 1

	--- @type number?
	local load = loadavg_file:read("*n")

	local load_percent = load and load / core_count * 100

	return load_percent
end

--- @return { [1]: number, [2]: SiPrefix }?, { [1]: number, [2]: SiPrefix }?
local function collect_mem_swap()
	local meminfo_file = io.open("/proc/meminfo", "r")
	if not meminfo_file then
		return
	end

	--- @type string
	local meminfo = meminfo_file:read("*a")

	local mem_total = tonumber(meminfo:match("MemTotal:%s+(%d+)"))
	local mem_free = tonumber(meminfo:match("MemAvailable:%s+(%d+)"))
	local swap_total = tonumber(meminfo:match("SwapTotal:%s+(%d+)"))
	local swap_free = tonumber(meminfo:match("SwapFree:%s+(%d+)"))

	local mem_used = mem_total and mem_free and mem_total - mem_free
	local swap_used = swap_total and swap_free and swap_total - swap_free

	return mem_used and readable_si_size(mem_used, "k"), swap_used and readable_si_size(swap_used, "k")
end

--- @return { [1]: number, [2]: SiPrefix }?
local function collect_rootfs()
	local stat = io.popen("stat -f / -c '%a %S'")
	if not stat then
		return
	end

	--- @type number?
	local rootfs_free_blocks = stat:read("*n")
	--- @type number?
	local rootfs_block_size = stat:read("*n")

	local rootfs_free = rootfs_free_blocks and rootfs_block_size and rootfs_free_blocks * rootfs_block_size

	return rootfs_free and readable_si_size(rootfs_free)
end

--- @return table
local function collect_thermal()
	local thermal = {}

	for filename in lfs.dir("/sys/class/thermal/") do
		--- @cast filename string

		local zone_i = tonumber(filename:match("thermal_zone([0-9]+)"))
		if not zone_i then
			goto continue
		end

		local temp_file = io.open("/sys/class/thermal/" .. filename .. "/temp")
		local type_file = io.open("/sys/class/thermal/" .. filename .. "/type")
		if not temp_file or not type_file then
			goto continue
		end

		--- @type string?
		local name = type_file:read("*l")
		--- @type number?
		local value = temp_file:read("*n")

		thermal[zone_i + 1] = { name = name, value = value and value / 1000 }

		::continue::
	end

	return thermal
end

