-----------------
--- core loop ---
-----------------

local cpu_core_count = collect_cpu_core_count()

while true do
	local cpu_load = collect_cpu_load_percent(cpu_core_count)
	if cpu_load then
		print("CPU", string.format("%.1f%%", cpu_load))
	end

	local mem, swap = collect_mem_swap()
	if mem then
		local s, p = table.unpack(mem)
		print("RAM", string.format("%.2f%s", s, p))
	end
	if swap then
		local s, p = table.unpack(swap)
		print("SWAP", string.format("%.2f%s", s, p))
	end

	local rootfs = collect_rootfs()
	if rootfs then
		local s, p = table.unpack(rootfs)
		print("ROOT FREE", string.format("%.2f%s", s, p))
	end

	local thermal = collect_thermal()
	if thermal then
		for i, v in ipairs(thermal) do
			print("THERMAL " .. i, string.format("%s - %.2f oC", v.name, v.value))
		end
	end

	print("------")
	unistd.sleep(1)
end
