-----------------
--- core loop ---
-----------------

local cpu_core_count = collect_cpu_core_count()

while true do
	local cpu_load = collect_cpu_load(cpu_core_count)
	if cpu_load then
		print("CPU", string.format("%.1f%% (%.2f risk)", cpu_load.value, cpu_load.risk))
	end

	local mem, swap = collect_mem_swap()
	if mem then
		print("RAM", string.format("%.2f%s (%.2f risk)", mem.value[1], mem.value[2], mem.risk))
	end
	if swap then
		print("SWAP", string.format("%.2f%s (%.2f risk)", swap.value[1], swap.value[2], swap.risk))
	end

	local rootfs = collect_rootfs()
	if rootfs then
		print("ROOT FREE", string.format("%.2f%s (%.2f risk)", rootfs.value[1], rootfs.value[2], rootfs.risk))
	end

	local thermal = collect_thermal()
	for i, t in pairs(thermal) do
		print("THERMAL " .. i, string.format("%.2f oC (%.2f risk) | %s", t.value, t.risk, t.label))
	end

	print("------")
	posix.time.nanosleep({ tv_nsec = 999999999 })
end
